# repos — Tilt extension for the `repos` multi-repo branch tool.
#
#     v1alpha1.extension_repo(name='repos', url='https://…/tilt-devenv')
#     v1alpha1.extension(name='repos', repo_name='repos', repo_path='tilt')
#     load('ext://repos', 'repos_load', 'repos_status_ui', 'repos_browse_url', 'repos_link')
#
#     repos = repos_load()
#     repos_status_ui({'my-service': 'my-service-repo'}, repos)
#
# For profile-gated resources, also load `repos_profiles_load`,
# `repos_active_profiles`, and `repos_profile_enabled`. See their docstrings
# below.
#
# Requires `repos` and `repos-tiltd` on PATH. Get them from the Nix flake, or
# `cargo install --path crates/repos --path crates/repos-tiltd`.
#
# The loading Tiltfile must sit at or under the dev-env root, wherever
# `tilt-devenv.json` lives.

def repos_bin():
    """
    The `repos` CLI invocation: `$REPOS_BIN`, else `repos` from PATH.

    A command prefix, not just a path, so it can be a builder:
    `REPOS_BIN='cargo run --manifest-path /abs/Cargo.toml -p repos --'`. Read
    per call, so `os.putenv` in the loading Tiltfile still takes effect.
    """
    return os.getenv('REPOS_BIN', 'repos')

def repos_tiltd_bin():
    """
    The `repos-tiltd` daemon invocation: `$REPOS_TILTD_BIN`, else PATH.
    """
    return os.getenv('REPOS_TILTD_BIN', 'repos-tiltd')

def repos_load(clone_missing=True):
    """
    Resolves every repo via `repos list --json`.

    Returns {name: struct(name, url, group, path, present)}.

    When `clone_missing` is set, `repos clone` runs first. That's scoped to
    the active profile, not the whole registry.

    Use `repos_resolve()` instead if you need registry order.
    """
    return {r.name: r for r in repos_resolve(clone_missing=clone_missing)}

def repos_resolve(clone_missing=True):
    """
    Like `repos_load`, but returns a list in registry order.
    """
    # Reload on a worktree-selection change, so picking one re-resolves the
    # affected resource's path and restarts it.
    bin = repos_bin()
    watch_file(str(local('%s worktree state-path' % bin, quiet=True, echo_off=True)).strip())
    if clone_missing:
        local('%s clone' % bin, quiet=True, echo_off=True)
    resolved = decode_json(str(local(
        '%s list --json' % bin,
        quiet=True,
        echo_off=True,
    )))
    return [_make_repo(r) for r in resolved]

def _make_repo(r):
    return struct(
        name=r['name'],
        url=r['url'],
        group=r['group'],
        path=r['path'],
        present=r['present'],
    )

def repos_profiles_load():
    """
    Resolves `tilt-devenv.json`'s `profiles`, via `repos profiles --json`.

    Returns {profile_name: [repo-or-group name, ...]}.
    """
    return decode_json(str(local(
        '%s profiles --json' % repos_bin(),
        quiet=True,
        echo_off=True,
    )))

def repos_active_profiles():
    """
    The persisted active profile selection.

    Empty means every profile is enabled.

    Watches its state file, so picking a profile reloads the Tiltfile and
    redefines resources to match.
    """
    bin = repos_bin()
    watch_file(str(local('%s profile state-path' % bin, quiet=True, echo_off=True)).strip())
    return decode_json(str(local(
        '%s profile active --json' % bin,
        quiet=True,
        echo_off=True,
    )))

def repos_profile_enabled(repo, profiles, active):
    """
    True if `repo` (`.name`/`.group`) belongs to any of the `active`
    profiles.

    `profiles` maps profile name -> repo/group names, from
    `repos_profiles_load()`.

    No profiles defined means nothing to scope to — everything's enabled.
    Otherwise an empty `active` means none is enabled yet, not all.
    """
    if not profiles:
        return True
    if not active:
        return False
    return any([
        repo.name in profiles.get(p, []) or repo.group in profiles.get(p, [])
        for p in active
    ])

def repos_browse_url(remote):
    """
    Turns a git remote into a browsable `https://host/path` URL.

    Handles scp-SSH (`git@host:path`), `ssh://host/path`, and
    `https://host/path` forms. Works for gitlab.com, github.com, or
    self-hosted alike.
    """
    if remote.startswith('ssh://'):
        rest = remote[len('ssh://'):]           # [user@]host[:port]/path
        parts = rest.split('/', 1)
        host = parts[0].split('@')[-1].split(':')[0]
        path = parts[1] if len(parts) > 1 else ''
    elif '://' in remote:                        # https:// or http://
        rest = remote.split('://', 1)[1]
        parts = rest.split('/', 1)
        host = parts[0].split('@')[-1]
        path = parts[1] if len(parts) > 1 else ''
    else:                                         # scp-like: [user@]host:path
        userhost, path = remote.split(':', 1)
        host = userhost.split('@')[-1]
    if path.endswith('.git'):
        path = path[:-len('.git')]
    return 'https://%s/%s' % (host, path)

def repos_link(remote, label='Repo'):
    """
    A Tilt `link` to the browsable page for a git `remote`.

    See `repos_browse_url`. Example: `repos_link(repos['foo'].url)`.
    """
    return link(repos_browse_url(remote), label)

def repos_status_ui(
        branch_resources,
        repos,
        status_links=[],
        rust_log='repos_tiltd=info,repos_core=info',
        deps=[],
        labels=None):
    """
    Creates two long-lived resources: `repos-branches` (branch/pull buttons
    and checkout-all — the only one of the two that fetches remotes) and
    `git-status` (a live status table that only reads local git state, so it
    can't race that fetch).

    `branch_resources` maps a Tilt resource name to the repo name (a key in
    `repos`). `status_links` are extra `link()`s for the status pane.
    """
    spec = [
        {'resource': res, 'repo': repo, 'path': repos[repo].path, 'group': repos[repo].group}
        for res, repo in branch_resources.items()
    ]
    local_resource(
        'repos-branches',
        serve_cmd=repos_tiltd_bin(),
        serve_env={
            'REPOS_TILT_SPEC': encode_json(spec),
            'RUST_LOG': rust_log,
        },
        deps=deps,
        allow_parallel=True,
        labels=labels if labels else [],
    )
    local_resource(
        'git-status',
        serve_cmd='%s status --watch' % repos_bin(),
        deps=deps,
        allow_parallel=True,
        links=status_links,
        labels=labels if labels else [],
    )
