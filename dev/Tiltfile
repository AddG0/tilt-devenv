# Development harness for tilt-devenv itself — every `repos` / `repos-tiltd`
# invocation runs from source via `cargo run` (rebuilt + restarted on crate
# changes), instead of the Nix-packaged binaries examples/Tiltfile uses.
# `just dev` runs this.
#
#   ./bootstrap.sh    # create local demo repos + tilt-devenv.json (offline)
#   just dev           # from the repo root, inside `nix develop`
#
# Deliberately independent of examples/ (its own bootstrap.sh, tilt-devenv.json,
# Tiltfile) — examples/ stays a clean reference for real consumers, with
# nothing here coupled into it.
allow_k8s_contexts(k8s_context())

load('../tilt/Tiltfile', 'repos_load', 'repos_status_ui', 'repos_link',
     'repos_profiles_load', 'repos_active_profiles', 'repos_enabled')
load('ext://uibutton', 'cmd_button')

_root = os.path.abspath('..')

# Source builds for the whole Tiltfile — the load-time CLI calls too, not just the
# long-lived resources.
os.putenv('REPOS_BIN', 'cargo run --manifest-path %s/Cargo.toml -p repos --' % _root)
os.putenv('REPOS_TILTD_BIN', 'cargo run --manifest-path %s/Cargo.toml -p repos-tiltd' % _root)

profiles = repos_profiles_load()
active = repos_active_profiles()
repos = repos_load()
enabled = {name: r for name, r in repos.items() if repos_enabled(r, profiles, active)}

# Resource name == repo name here, so the mapping is identity.
repos_status_ui(
    {name: name for name in enabled},
    repos,
    labels=['repos'],
    deps=['%s/crates' % _root],
)

# A button on the git-status pane for testing: toggles alpha between main and
# feature-x so you can see the live status table pick up a real git change
# (a branch switch, computed purely locally, needs no fetch).
if 'alpha' in repos:
    cmd_button(
        'repos-status-test-trigger',
        argv=['sh', '-c', '''
            cd "$1"
            current=$(git rev-parse --abbrev-ref HEAD)
            git checkout "$([ "$current" = main ] && echo feature-x || echo main)"
        ''', '--', repos['alpha'].path],
        resource='git-status',
        icon_name='call_split',
        text='toggle alpha branch (test)',
    )

# A stand-in "service" per enabled repo, just so the branch buttons have a
# resource to attach to.
for name in enabled:
    r = enabled[name]
    local_resource(
        name,
        cmd='echo "%s @ %s" && git -C %s branch --show-current' % (name, r.path, r.path),
        links=[repos_link(r.url, 'Remote')],
        labels=['demo'],
        allow_parallel=True,
    )
