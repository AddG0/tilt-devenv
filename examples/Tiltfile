# Demo of the `repos` Tilt extension, runnable in isolation.
#
#   ./bootstrap.sh    # create local demo repos + tilt-devenv.json (offline)
#   tilt up           # from inside `nix develop` (provides `repos` + `tilt`)
#
# Two profiles are defined in tilt-devenv.json (alpha-only, beta-only), so
# nothing runs until one is picked — try `repos profile set alpha-only`
# (or the daemon's nav "profiles" button) to bring its repo's resources up.
#
# This demo is local-only (no Kubernetes); allow whatever kube context is
# active so Tilt's production-context guard doesn't block the local() calls.
allow_k8s_contexts(k8s_context())

# Real consumers load the extension via ext:// (see the top-level README). Here
# we load it by relative path so the example tracks the extension source
# directly with no clone/cache step.
load('../tilt/Tiltfile', 'repos_load', 'repos_status_ui', 'repos_link',
     'repos_profiles_load', 'repos_active_profiles', 'repos_profile_enabled')

profiles = repos_profiles_load()
active = repos_active_profiles()
repos = repos_load()
enabled = {name: r for name, r in repos.items() if repos_profile_enabled(r, profiles, active)}

# Resource name == repo name here, so the mapping is identity.
repos_status_ui(
    {name: name for name in enabled},
    repos,
    labels=['repos'],
)

# A stand-in "service" per enabled repo, just so the branch buttons have a
# resource to attach to.
for name in enabled:
    r = enabled[name]
    local_resource(
        name,
        cmd='echo "%s @ %s" && git -C %s branch --show-current' % (name, r.path, r.path),
        links=[repos_link(r.url, 'Remote')],
        labels=['demo'],
        allow_parallel=True,
    )
