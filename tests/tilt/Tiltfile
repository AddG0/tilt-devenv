# Automated test fixture for the `repos` Tilt extension.
#
# Driven by tests/tilt/run.sh, which points REPOS_ROOT at a temp workspace of
# throwaway repos and execs `tilt alpha tiltfile-result` against this file. Any
# `fail()` below aborts the Tiltfile, which the harness sees as a non-zero exit
# / populated `.Error`; the harness additionally asserts the resource set.
#
# The extension is loaded by relative path (../../tilt/Tiltfile from here), so
# this fixture exercises the real source with no clone/cache step.

# Local-only; allow whatever kube context is active (none, in the sandbox).
allow_k8s_contexts(k8s_context())

load('../../tilt/Tiltfile', 'repos_load', 'repos_resolve', 'repos_status_ui', 'repos_browse_url',
     'repos_link', 'repos_profiles_load', 'repos_active_profiles', 'repos_enabled',
     'repos_bin', 'repos_tiltd_bin')

# Unit assertions for repos_browse_url (pure remote -> browsable URL parser).
def _eq(got, want, msg):
    if got != want:
        fail('repos_browse_url %s: got %r, want %r' % (msg, got, want))

_eq(repos_browse_url('git@gitlab.com:acme/foo.git'),
    'https://gitlab.com/acme/foo', 'scp-ssh')
_eq(repos_browse_url('git@github.com:acme/group/foo.git'),
    'https://github.com/acme/group/foo', 'scp-ssh nested path')
_eq(repos_browse_url('gitlab.com:acme/foo.git'),
    'https://gitlab.com/acme/foo', 'scp-ssh no user')
_eq(repos_browse_url('ssh://git@gitlab.com/acme/foo.git'),
    'https://gitlab.com/acme/foo', 'ssh://')
_eq(repos_browse_url('ssh://git@host.example.com:2222/acme/foo.git'),
    'https://host.example.com/acme/foo', 'ssh:// with port')
_eq(repos_browse_url('https://gitlab.com/acme/foo.git'),
    'https://gitlab.com/acme/foo', 'https with .git')
_eq(repos_browse_url('https://gitlab.com/acme/foo'),
    'https://gitlab.com/acme/foo', 'https without .git')
_eq(repos_browse_url('https://user@github.com/acme/foo.git'),
    'https://github.com/acme/foo', 'https with userinfo')

_l = repos_link('git@gitlab.com:acme/foo.git', 'Src')
_eq(_l.url, 'https://gitlab.com/acme/foo', 'repos_link url')

# Unit assertions for repos_enabled (pure membership check).
_pf = {'frontend': ['web', 'design-system'], 'backend': ['auth']}
_eq(repos_enabled(struct(name='web', group='ui'), _pf, ['frontend']),
    True, 'enabled by name')
_eq(repos_enabled(struct(name='web', group='ui'), _pf, ['backend']),
    False, 'not enabled under an unrelated profile')
_eq(repos_enabled(struct(name='other', group='ui'), _pf, ['frontend', 'backend']),
    False, 'unlisted repo stays disabled')
_eq(repos_enabled(struct(name='web', group='ui'), {'ui-team': ['ui']}, ['ui-team']),
    True, 'enabled by group')
_eq(repos_enabled(struct(name='other', group='ui'), _pf, []),
    False, 'empty active means none enabled yet, when profiles exist')
_eq(repos_enabled(struct(name='other', group='ui'), {}, []),
    True, 'no profiles defined means nothing to scope to')

# run.sh clears both env vars, so these are the unset defaults.
_eq(repos_bin(), 'repos', 'repos_bin default')
_eq(repos_tiltd_bin(), 'repos-tiltd', 'repos_tiltd_bin default')

# Nothing has been picked yet, so the persisted selection is empty (every
# profile active) — checked before anything below picks one.
active = repos_active_profiles()
if active != []:
    fail('repos_active_profiles default = %r, want empty (every profile active)' % active)

# A bare load with no active profile deliberately clones nothing (profiles
# exist precisely so a developer never has to clone every repo — see
# `Registry::is_unscoped`), so pick one covering both repos first.
local('%s profile set alpha-only,beta-only' % repos_bin(), quiet=True, echo_off=True)

# Integration: resolve the registry, clone missing repos, wire the live UI.
repos = repos_load()

# The registry the harness writes has exactly these two repos.
if sorted(repos.keys()) != ['alpha', 'beta']:
    fail('repos_load returned %r, want [alpha, beta]' % sorted(repos.keys()))

# The registry the harness writes has exactly these two profiles.
profiles = repos_profiles_load()
if profiles != {'alpha-only': ['alpha'], 'beta-only': ['beta']}:
    fail('repos_profiles_load returned %r' % profiles)

for name in repos:
    r = repos[name]
    if not r.present:
        fail('%s: expected present=True after repos_load(clone_missing)' % name)
    local_resource(name, cmd='true', labels=['svc'], allow_parallel=True)

# $REPOS_SHIM (run.sh) logs each call and execs the real `repos`, so a resolve
# through it proves the CLI calls honor $REPOS_BIN rather than a hardcoded name.
os.putenv('REPOS_BIN', os.getenv('REPOS_SHIM'))
os.putenv('REPOS_TILTD_BIN', 'shim-tiltd')

if sorted([r.name for r in repos_resolve(clone_missing=False)]) != ['alpha', 'beta']:
    fail('repos_resolve through $REPOS_BIN did not resolve the registry')

# The status UI must create exactly the repos-branches daemon + git-status table.
repos_status_ui({name: name for name in repos}, repos, labels=['repos'])
